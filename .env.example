# RoboScope Environment Configuration

# JWT Secret Key for authenticating users (generate a random 32+ char string in production)
JWT_SECRET_KEY=roboscope-super-secret-jwt-key-2026-xyz-embodied-ai
JWT_EXPIRY_HOURS=168

# Backend CORS Allowed Origins (comma-separated or * in development)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000

# Ingestion interval in hours for background arXiv indexing
INGESTION_INTERVAL_HOURS=6

# Optional Frontend API URL override (leave blank to use /api proxy)
VITE_API_URL=
